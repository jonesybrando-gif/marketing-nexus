// Advertising Budget Pacing — database schema.
//
// Conventions
// - Every tenant-owned row carries agencyId (directly or through its parent) so
//   queries can always be scoped to one agency.
// - Money is stored as integer minor units (cents) in BigInt columns, never floats.
//   Each money column sits next to a currency code.
// - Calendar dates for reporting ("the day the spend happened in the client's
//   timezone") are stored as DATE columns, not timestamps.
// - Daily performance rows are stored at the leaf level only (campaign, or
//   account when the platform has no campaign granularity). Rollups are always
//   computed from leaves so spend is never double-counted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy, users and permissions
// ---------------------------------------------------------------------------

model Agency {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // White-label branding
  logoUrl       String?
  brandColor    String  @default("#4f46e5")
  reportHeader  String?
  reportFooter  String?
  // Default pacing thresholds (percent of expected spend). Overridable per client.
  thresholdUnder         Decimal @default(85) @db.Decimal(6, 2)
  thresholdSlightlyUnder Decimal @default(95) @db.Decimal(6, 2)
  thresholdSlightlyOver  Decimal @default(105) @db.Decimal(6, 2)
  thresholdOver          Decimal @default(115) @db.Decimal(6, 2)
  defaultTimezone String @default("America/New_York")
  // Alert thresholds; see src/lib/alerts.ts for defaults.
  alertSettings Json?
  /// Slack incoming-webhook URL for new alerts, encrypted like OAuth tokens. Null = Slack off.
  slackWebhookEnc String?
  /// When an admin dismissed the "Get set up" checklist (null = showing).
  setupChecklistDismissedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  clients           Client[]
  clientLabels      ClientLabel[]
  platformConnections PlatformConnection[]
  alerts            Alert[]
  reports           Report[]
  dataSourceConnections DataSourceConnection[]
  dashboards            Dashboard[]
}

enum Role {
  AGENCY_ADMIN
  ACCOUNT_MANAGER
  CLIENT_USER
}

model User {
  id           String   @id @default(cuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  // Null until an invited user sets a password.
  passwordHash String?
  role         Role
  deactivatedAt DateTime?
  lastLoginAt   DateTime?
  // Sessions issued before this instant are rejected (set on password change, deactivation).
  sessionsValidAfter DateTime?
  // Notification preferences (agency staff only)
  emailAlerts   Boolean  @default(true)
  dailySummary  Boolean  @default(true)
  lastDailySummaryAt DateTime?
  // CLIENT_USER only: the single client this user may read.
  clientId     String?
  client       Client?  @relation("ClientUsers", fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ACCOUNT_MANAGER: clients explicitly assigned to them.
  assignments ClientAssignment[]
  managedClients Client[] @relation("PrimaryManager")
  budgetRevisions BudgetRevision[]
  notifications Notification[]
  authTokens AuthToken[]

  @@index([agencyId])
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

// Single-use links for invitations and password resets. Only a SHA-256 hash
// of the token is stored; the token itself exists only in the emailed link.
model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, type])
}

enum EmailStatus {
  SENT
  FAILED
  NOT_CONFIGURED // no email provider configured; kept in the outbox only
}

// Every email the app sends (or would send) is recorded here.
model EmailMessage {
  id        String   @id @default(cuid())
  agencyId  String?
  to        String
  subject   String
  text      String
  html      String?
  kind      String   // "invite" | "password_reset" | "alert" | "daily_summary" | "client_email"
  status    EmailStatus
  error     String?
  createdAt DateTime @default(now())

  @@index([agencyId, createdAt])
}

model ClientAssignment {
  userId   String
  clientId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, clientId])
}

// ---------------------------------------------------------------------------
// Clients and advertising accounts
// ---------------------------------------------------------------------------

model Client {
  id        String  @id @default(cuid())
  agencyId  String
  agency    Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  timezone  String  @default("America/New_York")
  /// What the client wants from advertising; null = guessed from the data.
  goal      ClientGoal?
  /// Alert types muted for this client (not raised, shown or emailed; open ones close).
  mutedAlertTypes AlertType[] @default([])
  currency  String  @default("USD") @db.Char(3)
  /// The client's own logo for their report, shared links and PDF: an https URL or an inline PNG/JPEG data URL (resized to 256 px). Null = initials.
  logoUrl   String?
  primaryManagerId String?
  primaryManager   User?  @relation("PrimaryManager", fields: [primaryManagerId], references: [id], onDelete: SetNull)
  // Per-client threshold overrides (null = use agency defaults)
  thresholdUnder         Decimal? @db.Decimal(6, 2)
  thresholdSlightlyUnder Decimal? @db.Decimal(6, 2)
  thresholdSlightlyOver  Decimal? @db.Decimal(6, 2)
  thresholdOver          Decimal? @db.Decimal(6, 2)
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  accounts    AdAccount[]
  budgets     Budget[]
  users       User[]  @relation("ClientUsers")
  aiInsights  AiInsight[]
  shareLinks  ReportShareLink[]
  assignments ClientAssignment[]
  alerts      Alert[]
  reports     Report[]
  labels      ClientLabel[]
  chartNotes  ChartNote[]
  dataAssets  DataAsset[]
  dashboards  Dashboard[]
  insightStatuses InsightStatus[]
  nextSteps   NextStep[]

  @@index([agencyId])
}

/// A note pinned to a date on a client's charts (a launch, a budget change),
/// optionally shown on the client-facing report and optionally tagging a teammate.
model ChartNote {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  text          String
  clientVisible Boolean  @default(false)
  authorId      String?
  taggedUserId  String?
  createdAt     DateTime @default(now())

  @@index([clientId, date])
}

// Agency-defined tags for grouping, sorting and filtering clients.
model ClientLabel {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  // One of the badge tones: neutral, info, good, warning, serious, critical.
  color     String   @default("neutral")
  createdAt DateTime @default(now())
  clients   Client[]

  @@unique([agencyId, name])
}

enum Platform {
  GOOGLE_ADS
  META_ADS
  MICROSOFT_ADS
  GOOGLE_LSA
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
  PENDING_APPROVAL
}

// One OAuth grant (e.g. a Google Ads MCC login). Several AdAccounts can hang off it.
model PlatformConnection {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  platform  Platform
  label     String
  // Platform login identifier (e.g. MCC customer id, Meta business id)
  externalId String?
  status    ConnectionStatus @default(ACTIVE)
  // Last connection-level error (e.g. revoked token, developer token not approved)
  lastError String?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credential OAuthCredential?
  accounts   AdAccount[]

  @@index([agencyId, platform])
}

// Tokens are encrypted with AES-256-GCM (see src/server/crypto.ts) before storage
// and are only ever decrypted on the server.
model OAuthCredential {
  id                    String   @id @default(cuid())
  connectionId          String   @unique
  connection            PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  scopes                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AdAccount {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   PlatformConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  platform     Platform
  externalId   String   // platform account id, digits only for Google Ads (e.g. "1234567890")
  // Google Ads: manager (MCC) id sent as login-customer-id when access is through a manager.
  loginCustomerId String?
  name         String
  currency     String   @db.Char(3)
  timezone     String?
  // True for sample data. Demo rows are always labelled in the UI and are never
  // mixed into an account backed by a live integration.
  isDemo       Boolean  @default(false)
  // Whether the platform reports verified spend for this account. Google LSA may not.
  spendIsVerified Boolean @default(true)
  // When false, campaigns first seen in a sync start out left out of reports.
  includeNewCampaigns Boolean @default(true)
  status       ConnectionStatus @default(ACTIVE)
  lastSyncAttemptAt   DateTime?
  lastSuccessfulSyncAt DateTime?
  // Last local date for which the platform's reporting is considered complete.
  dataCompleteThrough DateTime? @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns   Campaign[]
  budgets     Budget[]
  performance DailyPerformance[]
  syncRuns    SyncRun[]
  alerts      Alert[]

  @@unique([platform, externalId, clientId])
  @@index([clientId])
}

enum CampaignStatus {
  ENABLED
  PAUSED
  REMOVED
  UNKNOWN
}

model Campaign {
  id          String   @id @default(cuid())
  accountId   String
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  status      CampaignStatus @default(UNKNOWN)
  // Platform-side daily budget, informational only (minor units). Set only
  // when platformBudgetKind is DAILY.
  platformDailyBudgetMinor BigInt?
  /// The platform budget behind this campaign (Google shared budgets feed several campaigns; count each once).
  platformBudgetId   String?
  /// "DAILY" | "LIFETIME" (total/lifetime budget, no fixed daily amount) | null = not reported by the platform.
  platformBudgetKind String?
  // Set when the campaign is left out of the client's reports, pacing and
  // alerts. Its data is still synced and kept, so it can be added back.
  excludedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budgets     Budget[]
  performance DailyPerformance[]

  @@unique([accountId, externalId])
}

// ---------------------------------------------------------------------------
// Budgets
// ---------------------------------------------------------------------------

enum BudgetScope {
  CLIENT   // combined budget across all of a client's accounts
  ACCOUNT  // one advertising account
  CAMPAIGN // one campaign
}

enum DistributionMode {
  EVEN             // every calendar day weighted equally
  BUSINESS_DAYS    // Mon–Fri only
  WEEKEND_WEIGHTED // weekend days get weekendWeight
  CUSTOM_WEEKDAY   // explicit weight per weekday (weekdayWeights)
  CUSTOM_DAILY     // explicit weight per date (dailyWeights) — seasonal patterns
}

enum ForecastModel {
  STRAIGHT_LINE
  TRAILING_7_DAY
}

// A budget for one scope over one period. Mid-period changes are BudgetRevisions.
model Budget {
  id         String      @id @default(cuid())
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scope      BudgetScope
  accountId  String?
  account    AdAccount?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Budget period, inclusive local dates in the client's timezone.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  currency    String   @db.Char(3)
  distribution  DistributionMode @default(EVEN)
  weekendWeight Decimal? @db.Decimal(6, 3)
  // JSON array of 7 numbers, Sunday first.
  weekdayWeights Json?
  // JSON object {"YYYY-MM-DD": weight}
  dailyWeights   Json?
  // JSON array of {"start":"YYYY-MM-DD","end":"YYYY-MM-DD"} pauses (no planned spend)
  pauses         Json?
  forecastModel  ForecastModel @default(STRAIGHT_LINE)
  /// Carried forward to the next calendar month automatically (whole-month budgets only).
  repeatsMonthly Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  revisions BudgetRevision[]

  @@index([clientId, periodStart])
  @@index([accountId])
  @@index([campaignId])
}

// Every budget amount is a revision. The first revision's effectiveDate equals
// periodStart; later revisions model mid-period changes.
model BudgetRevision {
  id            String   @id @default(cuid())
  budgetId      String
  budget        Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  amountMinor   BigInt
  effectiveDate DateTime @db.Date
  note          String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([budgetId, effectiveDate])
}

// ---------------------------------------------------------------------------
// Performance data
// ---------------------------------------------------------------------------

// One row per leaf entity per local date. campaignId is null only for platforms
// that report at the account level (e.g. Google LSA).
model DailyPerformance {
  id          String   @id @default(cuid())
  accountId   String
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  currency    String   @db.Char(3)
  costMinor   BigInt   @default(0)
  // Set when cost is an estimate (e.g. LSA charged leads × lead price).
  costIsEstimated Boolean @default(false)
  impressions BigInt   @default(0)
  clicks      BigInt   @default(0)
  reach       BigInt?
  // Platform-reported conversions. Platform definitions differ; never sum
  // these across platforms without labelling them as platform-reported.
  conversions      Decimal @default(0) @db.Decimal(14, 4)
  conversionValueMinor BigInt @default(0)
  leads            Decimal? @db.Decimal(14, 4)
  isDemo      Boolean  @default(false)
  syncedAt    DateTime @default(now())

  conversionMetrics ConversionMetric[]

  @@unique([accountId, campaignId, date])
  @@index([accountId, date])
  @@index([campaignId, date])
}

// Named conversion actions (e.g. Meta "lead", "purchase"; LSA "charged lead").
model ConversionMetric {
  id            String @id @default(cuid())
  performanceId String
  performance   DailyPerformance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  name          String
  source        String // "platform" | "crm" | ...
  value         Decimal @db.Decimal(14, 4)
  valueMinor    BigInt?

  @@index([performanceId])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  base      String   @db.Char(3)
  quote     String   @db.Char(3)
  rate      Decimal  @db.Decimal(18, 8)
  source    String

  @@unique([date, base, quote])
}

// ---------------------------------------------------------------------------
// Sync, alerts, reports
// ---------------------------------------------------------------------------

enum SyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model SyncRun {
  id         String   @id @default(cuid())
  accountId  String
  account    AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind       String   // "scheduled" | "manual" | "backfill"
  status     SyncStatus
  rangeStart DateTime? @db.Date
  rangeEnd   DateTime? @db.Date
  rowsUpserted Int    @default(0)
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([accountId, startedAt])
}

enum AlertType {
  OVERSPENDING
  UNDERSPENDING
  PROJECTED_OVERRUN
  SPEND_SPIKE
  SPEND_STOPPED
  CAMPAIGN_NO_SPEND
  SYNC_FAILED
  ACCOUNT_DISCONNECTED
  CPA_SPIKE
  RESULTS_DROP
  TRACKING_ZERO
}

enum ClientGoal {
  LEADS
  CALLS
  SALES
  BOOKINGS
  AWARENESS
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountId String?
  account   AdAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      AlertType
  status    AlertStatus @default(OPEN)
  severity  String   @default("warning") // "critical" | "warning" | "info"
  acknowledgedAt DateTime?
  acknowledgedById String?
  // Deduplication key: one OPEN/ACKNOWLEDGED alert per key.
  dedupeKey String
  message   String
  details   Json?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  resolvedAt  DateTime?
  /// Hidden from the open list until this time (the alert stays open and keeps updating).
  snoozedUntil DateTime?

  notifications Notification[]

  @@index([agencyId, status])
  @@index([dedupeKey, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId   String?
  alert     Alert?   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel   String   // "in_app" | "email"
  title     String
  body      String
  readAt    DateTime?
  sentAt    DateTime @default(now())

  @@index([userId, readAt])
}

model Report {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId  String?  // null = agency-wide report
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  // "TEMPLATE": the agency default (clientId null) or a client's override,
  // read through parseTemplate in src/lib/report-template.ts.
  kind      String   @default("SAVED")
  // Widget layout and settings
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules ReportSchedule[]

  @@index([agencyId, kind, clientId])
}

model ReportSchedule {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  frequency  String   // "weekly" | "monthly"
  dayOfWeek  Int?
  dayOfMonth Int?
  recipients String[]
  lastSentAt DateTime?
  nextRunAt  DateTime?
  enabled    Boolean  @default(true)
}

// Failed sign-in counters for throttling (see src/lib/login-throttle.ts).
model LoginThrottle {
  key         String   @id // "pair:<email>|<ip>", "ip:<ip>", "email:<email>"
  failures    Int      @default(0)
  windowStart DateTime @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

// Saved output of the AI assistant (see src/server/ai). Kept so suggestions
// aren't regenerated (and billed) on every page view.
model AiInsight {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind        String   // "suggestions"
  content     Json
  model       String
  rangeFrom   String   // ISO date the data covered
  rangeTo     String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([clientId, kind, createdAt])
}

// Read-only report links that work without signing in (src/server/share-links.ts).
// Only a SHA-256 hash of the token is used for lookup; the encrypted copy lets
// staff copy the link again later.
model ReportShareLink {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  tokenEnc     String
  label        String?
  // Fixed date range preset and comparison; null follows the report template.
  range        String?
  compare      String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  viewCount    Int       @default(0)
  /// bcrypt hash of an optional password viewers must enter. Null = no password.
  passwordHash String?

  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Non-ad data sources (GA4, Search Console, Business Profile, CallRail,
// Facebook/Instagram organic, rank tracking) and custom dashboards.
// See src/server/data-sources/README.md for the contract.
// ---------------------------------------------------------------------------

/// The login/credential kind. One connection can expose several asset kinds
/// (a Google login exposes GA4 properties, Search Console sites and Business
/// Profile locations).
enum DataSourceProvider {
  GOOGLE       // GA4, Search Console, Business Profile (one OAuth login)
  META_ORGANIC // Facebook Pages and Instagram business accounts
  CALLRAIL     // API key
  DATAFORSEO   // API login + password (rank tracking)
}

enum DataAssetKind {
  GA4_PROPERTY
  GSC_SITE
  GBP_LOCATION
  FB_PAGE
  IG_ACCOUNT
  CALLRAIL_COMPANY
  RANK_PROJECT
}

/// Agency-level credential for a non-ad data source. Secrets are encrypted
/// with src/server/crypto.ts and only decrypted on the server.
model DataSourceConnection {
  id                    String   @id @default(cuid())
  agencyId              String
  agency                Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  provider              DataSourceProvider
  label                 String
  externalId            String?
  status                ConnectionStatus @default(ACTIVE)
  lastError             String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  /// API key / secret for key-based providers (CallRail, DataForSEO).
  encryptedSecret       String?
  scopes                String?
  createdById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  assets DataAsset[]

  @@index([agencyId, provider])
}

/// One property / site / location / page / company / rank project, linked to a client.
model DataAsset {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   DataSourceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  kind         DataAssetKind
  externalId   String
  name         String
  timezone     String?
  /// Provider-specific settings (e.g. GSC site URL form, CallRail account id).
  settings     Json?
  status       ConnectionStatus @default(ACTIVE)
  lastError    String?
  lastSyncAttemptAt    DateTime?
  lastSuccessfulSyncAt DateTime?
  dataCompleteThrough  DateTime? @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  metrics  MetricDaily[]
  keywords TrackedKeyword[]
  calls    CallRecord[]
  forms    FormRecord[]

  @@unique([kind, externalId, clientId])
  @@index([clientId])
}

/// Daily metric values for non-ad sources. dimension/dimensionValue are ""
/// for account-level totals; otherwise e.g. ("channel","Organic Search"),
/// ("query","dentist near me"), ("page","/contact"), ("source","google").
/// Metric keys come from src/lib/metrics-registry (e.g. "ga4.sessions").
model MetricDaily {
  id             String   @id @default(cuid())
  assetId        String
  asset          DataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  clientId       String
  date           DateTime @db.Date
  metric         String
  dimension      String   @default("")
  dimensionValue String   @default("")
  value          Float

  @@unique([assetId, date, metric, dimension, dimensionValue])
  @@index([clientId, metric, date])
  @@index([assetId, date])
}

/// Keyword tracked for exact daily rank (DataForSEO).
model TrackedKeyword {
  id           String   @id @default(cuid())
  assetId      String
  asset        DataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  clientId     String
  keyword      String
  /// DataForSEO location code (e.g. 2840 = United States) and language.
  locationCode Int      @default(2840)
  languageCode String   @default("en")
  device       String   @default("desktop") // "desktop" | "mobile"
  targetDomain String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  ranks KeywordRank[]

  @@unique([assetId, keyword, locationCode, device])
  @@index([clientId])
}

model KeywordRank {
  id        String   @id @default(cuid())
  keywordId String
  keyword   TrackedKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  /// Organic position, null when not in the checked results.
  position  Int?
  url       String?
  serpFeatures Json?
  checkedAt DateTime @default(now())

  @@unique([keywordId, date])
}

/// A custom dashboard (AgencyAnalytics-style). clientId null + isTemplate =
/// agency template that can be applied to clients. widgets: see
/// src/lib/dashboards/types.ts (DashboardWidget[]).
model Dashboard {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  isTemplate  Boolean  @default(false)
  /// Shown on the client-facing report / to client logins.
  clientVisible Boolean @default(true)
  position    Int      @default(0)
  defaultRange String  @default("last_30")
  widgets     Json     @default("[]")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId, isTemplate])
  @@index([clientId, position])
}

/// One tracked call (CallRail), for call logs. Kept 13 months, refreshed with each sync window.
model CallRecord {
  id             String    @id @default(cuid())
  assetId        String
  asset          DataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  clientId       String
  externalId     String
  startedAt      DateTime
  /// Local calendar date in the company's time zone (for range filters).
  date           DateTime  @db.Date
  callerName     String?
  callerNumber   String?
  city           String?
  state          String?
  source         String?
  medium         String?
  campaign       String?
  keyword        String?
  landingPage    String?
  trackingNumber String?
  durationSec    Int       @default(0)
  answered       Boolean   @default(false)
  voicemail      Boolean   @default(false)
  firstCall      Boolean   @default(false)
  leadStatus     String?
  tags           String[]  @default([])
  /// CallRail's shareable recording player link (staff only).
  recordingUrl   String?

  @@unique([assetId, externalId])
  @@index([clientId, date])
  @@index([assetId, date])
}

/// One form submission (CallRail form tracking), for form logs. Kept 13 months.
model FormRecord {
  id           String    @id @default(cuid())
  assetId      String
  asset        DataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  clientId     String
  externalId   String
  submittedAt  DateTime
  date         DateTime  @db.Date
  name         String?
  formUrl      String?
  referrer     String?
  referringUrl String?
  firstForm    Boolean   @default(false)
  leadStatus   String?

  @@unique([assetId, externalId])
  @@index([clientId, date])
  @@index([assetId, date])
}

/// What the agency did with one AI recommendation for a client. Recommendations are
/// regenerated, so they're matched by a fingerprint of their title.
model InsightStatus {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fingerprint String
  title       String
  /// "REVIEWED" | "PLANNED" | "DONE" | "DISMISSED" (no row = new)
  status      String
  reason      String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, fingerprint])
}

/// A next step the agency tells the client about. AI may draft one; only a person
/// approves it (PLANNED, shown to the client) and only a person marks it DONE, with a date.
model NextStep {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text         String
  /// "DRAFT" (agency only) | "PLANNED" | "DONE"
  status       String    @default("DRAFT")
  /// Where a draft came from: the recommendation it was planned from, or the AI summary.
  source       String?
  sourceText   String?
  targetDate   DateTime? @db.Date
  doneOn       DateTime? @db.Date
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  doneById     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId, status])
}
